{
  "manifest_version": 3,
  "name": "Manufactogate",
  "description": "Çok pazarlı ürün araştırma köprüsü. Kendi oturumunla pazarlarda arama yapar, sonuçları Manufactogate uygulamasına taşır.",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "default_locale": "tr",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Manufactogate"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "cookies",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.1688.com/*",
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.tmall.hk/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.trendyol.com/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4173/*",
    "*://*.alibaba.com/*",
    "*://*.aliexpress.com/*",
    "*://*.aliexpress.us/*",
    "*://*.hepsiburada.com/*",
    "*://*.n11.com/*",
    "*://*.amazon.com.tr/*",
    "*://*.dhgate.com/*",
    "*://*.made-in-china.com/*",
    "*://*.globalsources.com/*",
    "*://*.yiwugo.com/*",
    "*://*.indiamart.com/*",
    "*://*.tradeindia.com/*",
    "*://*.tokopedia.com/*",
    "*://*.shopee.co.id/*",
    "*://*.lazada.co.th/*",
    "*://*.rakuten.co.jp/*",
    "*://*.mercari.com/*",
    "*://*.auctions.yahoo.co.jp/*",
    "*://*.coupang.com/*",
    "*://*.gmarket.co.kr/*",
    "*://*.amazon.de/*",
    "*://*.amazon.com/*",
    "*://*.ebay.com/*",
    "*://*.walmart.com/*",
    "*://*.temu.com/*",
    "*://*.noon.com/*",
    "*://*.ozon.ru/*",
    "*://*.wildberries.ru/*",
    "*://*.amazon.co.uk/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.1688.com/*",
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.tmall.hk/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*",
        "*://*.trendyol.com/*",
        "*://*.hepsiburada.com/*",
        "*://*.n11.com/*",
        "*://*.amazon.com.tr/*",
        "*://*.amazon.de/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://*.alibaba.com/*",
        "*://*.dhgate.com/*",
        "*://*.made-in-china.com/*",
        "*://*.globalsources.com/*",
        "*://*.yiwugo.com/*",
        "*://*.indiamart.com/*",
        "*://*.tradeindia.com/*",
        "*://*.tokopedia.com/*",
        "*://*.shopee.co.id/*",
        "*://*.lazada.co.th/*",
        "*://*.rakuten.co.jp/*",
        "*://*.mercari.com/*",
        "*://*.auctions.yahoo.co.jp/*",
        "*://*.coupang.com/*",
        "*://*.gmarket.co.kr/*",
        "*://*.ebay.com/*",
        "*://*.walmart.com/*",
        "*://*.temu.com/*",
        "*://*.noon.com/*",
        "*://*.ozon.ru/*",
        "*://*.wildberries.ru/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
