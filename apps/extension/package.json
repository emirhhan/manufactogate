{
  "name": "@manufactogate/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && vite build -c vite.extract.config.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/bridge.mjs"
  },
  "dependencies": {
    "@manufactogate/adapters": "workspace:*",
    "@manufactogate/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "playwright": "^1.56.0"
  }
}
